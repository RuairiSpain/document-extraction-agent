# Copy to src/.env for local runs. Never commit .env.
# FOUNDRY_PROJECT_ENDPOINT is injected in hosted Foundry containers and by `azd ai agent run`.
# Set it yourself only when running `python main.py` directly.
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>

# Deployment names for the two GPT models and the Mistral cross-check.
EXTRACTION_MODEL_MINI=gpt-5.4-mini
EXTRACTION_MODEL_PRO=gpt-5.4-pro
SECONDARY_EXTRACTION_MODEL=mistral-ocr-4-0

LOG_LEVEL=INFO
# EXTRACTION_TIMEOUT_SECONDS=1800
